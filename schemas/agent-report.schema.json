{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-electricity.internal/schemas/agent-report.schema.json",
  "title": "Agent Report",
  "description": "Structured output every agent must post as a PR/issue comment AND write to /logs/<agent>/<runId>.json, forming the audit trail.",
  "type": "object",
  "required": ["agent", "runId", "taskId", "timestamp", "status", "summary", "confidence"],
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "codegen-agent",
        "review-agent",
        "advisory-agent",
        "error-resolution-agent",
        "vcs-agent",
        "testing-agent",
        "orchestrator"
      ]
    },
    "runId": { "type": "string", "description": "Unique per invocation, used for idempotent re-runs (update, don't duplicate)." },
    "taskId": { "type": "string", "description": "Correlates back to the task.schema.json id that triggered this run." },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "escalated", "no-op"]
    },
    "summary": { "type": "string", "maxLength": 2000 },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Agent's self-reported confidence in its output/verdict."
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "request-changes", "pass", "fail", "n/a"],
      "description": "Only present for gate-producing agents (review-agent, testing-agent)."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "enum": ["branch", "pull_request", "file", "tag", "release", "adr", "log"] },
          "ref": { "type": "string" }
        }
      }
    },
    "escalation": {
      "type": "object",
      "description": "Present when status is 'blocked' or 'escalated'.",
      "properties": {
        "toAgent": { "type": "string" },
        "reason": { "type": "string" },
        "issueRef": { "type": "string" }
      }
    }
  }
}
